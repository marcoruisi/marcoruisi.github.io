  "examples": [
    {
      "id": "word-html",
      "title": {
        "it": "Da Word a HTML personalizzato",
        "en": "From Word to custom HTML"
      },
      "description": {
        "it": "Pulisci un documento formattato, poi modifica il codice con sostituzioni multiple.",
        "en": "Clean up a formatted document, then edit the HTML with multiple replacements."
      },
      "note": {
        "it": "Per mantenere titoli, grassetti ed elenchi, trasferisci il codice HTML, non il testo visualizzato.",
        "en": "To keep headings, bold text and lists, transfer the HTML code, not the rendered text."
      },
      "steps": [
        {
          "kind": "input",
          "label": {
            "it": "Documento Word",
            "en": "Word document"
          },
          "detail": {
            "it": "Titoli, grassetti, elenchi",
            "en": "Headings, bold text, lists"
          }
        },
        {
          "kind": "tool",
          "tool": "clean-wp-clipboard",
          "label": {
            "it": "HTML Editor",
            "en": "HTML Editor"
          },
          "detail": {
            "it": "Pulisci e copia il codice",
            "en": "Clean and copy the code"
          }
        },
        {
          "kind": "tool",
          "tool": "multiple-find-replace",
          "label": {
            "it": "Trova e sostituisci",
            "en": "Multiple Find & Replace"
          },
          "detail": {
            "it": "Applica modifiche in serie",
            "en": "Apply changes in bulk"
          }
        },
        {
          "kind": "output",
          "label": {
            "it": "HTML personalizzato",
            "en": "Custom HTML"
          },
          "detail": {
            "it": "Pronto da riutilizzare",
            "en": "Ready to reuse"
          }
        }
      ]
    },
    {
      "id": "images-pdf",
      "title": {
        "it": "Da immagini a PDF leggero",
        "en": "From images to a lighter PDF"
      },
      "description": {
        "it": "Riduci il peso delle immagini prima di raccoglierle in un unico documento.",
        "en": "Reduce image file sizes before bringing them together in one document."
      },
      "steps": [
        {
          "kind": "input",
          "label": {
            "it": "Immagini",
            "en": "Images"
          },
          "detail": {
            "it": "Foto e scansioni",
            "en": "Photos and scans"
          }
        },
        {
          "kind": "tool",
          "tool": "image-to-target-size",
          "label": {
            "it": "Foto entro il peso",
            "en": "Image to Target Size"
          },
          "detail": {
            "it": "Alleggerisci i file",
            "en": "Make the files smaller"
          }
        },
        {
          "kind": "tool",
          "tool": "images-to-pdf",
          "label": {
            "it": "Immagini in PDF",
            "en": "Images to PDF"
          },
          "detail": {
            "it": "Riunisci le immagini",
            "en": "Bring the images together"
          }
        },
        {
          "kind": "output",
          "label": {
            "it": "PDF più leggero",
            "en": "Lighter PDF"
          },
          "detail": {
            "it": "Pronto da condividere",
            "en": "Ready to share"
          }
        }
      ]
    },
    {
      "id": "print-web",
      "title": {
        "it": "Da PDF per la stampa a PDF per il web",
        "en": "From a print PDF to a web-ready PDF"
      },
      "description": {
        "it": "Rimuovi abbondanze e segni di taglio, poi riduci il peso del documento.",
        "en": "Remove bleed and crop marks, then reduce the document’s file size."
      },
      "steps": [
        {
          "kind": "input",
          "label": {
            "it": "PDF da stampa",
            "en": "Print PDF"
          },
          "detail": {
            "it": "Con abbondanze e segni",
            "en": "With bleed and crop marks"
          }
        },
        {
          "kind": "tool",
          "tool": "print-pdf-to-web",
          "label": {
            "it": "Da stampa a web",
            "en": "Print PDF to Web"
          },
          "detail": {
            "it": "Ritaglia la pagina",
            "en": "Crop the page"
          }
        },
        {
          "kind": "tool",
          "tool": "pdf-compressor",
          "label": {
            "it": "PDF Compressor",
            "en": "PDF Compressor"
          },
          "detail": {
            "it": "Alleggerisci il documento",
            "en": "Reduce the file size"
          }
        },
        {
          "kind": "output",
          "label": {
            "it": "PDF per il web",
            "en": "Web-ready PDF"
          },
          "detail": {
            "it": "Pronto da inviare",
            "en": "Ready to send"
          }
        }
      ]
    },
    {
      "id": "folder-inventory",
      "title": {
        "it": "Documentare il contenuto di una cartella",
        "en": "Document the contents of a folder"
      },
      "description": {
        "it": "Crea un inventario dei file per una consegna o un archivio. Scegli quali informazioni conservare e come organizzarle.",
        "en": "Create a file inventory for a handover or archive. Choose which information to keep and how to organise it."
      },
      "note": {
        "it": "Scarica la tabella CSV da Elenca file e aprila nell’Editor CSV. Puoi anche suddividerla per estensione o cartella.",
        "en": "Download the CSV table from List files and open it in the CSV Editor. You can also split it by extension or folder."
      },
      "steps": [
        {
          "kind": "input",
          "label": {
            "it": "Cartella di lavoro",
            "en": "Project folder"
          },
          "detail": {
            "it": "File e sottocartelle",
            "en": "Files and subfolders"
          }
        },
        {
          "kind": "tool",
          "label": {
            "it": "Elenca file",
            "en": "List files"
          },
          "detail": {
            "it": "Scegli profondità e filtri",
            "en": "Choose depth and filters"
          },
          "tool": "file-inventory"
        },
        {
          "kind": "tool",
          "label": {
            "it": "Editor CSV",
            "en": "CSV Editor"
          },
          "detail": {
            "it": "Riordina, filtra e scegli le colonne",
            "en": "Sort, filter and choose columns"
          },
          "tool": "csv-editor"
        },
        {
          "kind": "output",
          "label": {
            "it": "Inventario CSV",
            "en": "CSV inventory"
          },
          "detail": {
            "it": "Pronto da consultare o consegnare",
            "en": "Ready to review or hand over"
          }
        }
      ]
    },
    {
      "id": "csv-split",
      "title": {
        "it": "Dividere una tabella in elenchi pronti all’uso",
        "en": "Split a table into ready-to-use lists"
      },
      "description": {
        "it": "Da una tabella unica a elenchi separati per città, lingua o categoria. Controlla i dati e scegli come raggrupparli.",
        "en": "Turn a single table into separate lists by city, language or category. Review the data and choose how to group it."
      },
      "note": {
        "it": "Nello stesso editor, correggi i dati e applica eventuali filtri. Poi scegli la colonna di suddivisione: ogni CSV conserva le intestazioni, se attive. Puoi esportare tutte le righe o solo quelle filtrate.",
        "en": "In the same editor, correct the data and apply any filters. Then choose the split column: each CSV keeps the headers when enabled. Export all rows or only the filtered ones."
      },
      "steps": [
        {
          "kind": "input",
          "label": {
            "it": "Tabella CSV",
            "en": "CSV table"
          },
          "detail": {
            "it": "Contatti, prodotti o materiali",
            "en": "Contacts, products or assets"
          }
        },
        {
          "kind": "tool",
          "label": {
            "it": "Editor CSV",
            "en": "CSV Editor"
          },
          "detail": {
            "it": "Modifica, filtra e suddividi per colonna",
            "en": "Edit, filter and split by column"
          },
          "tool": "csv-editor"
        },
        {
          "kind": "output",
          "label": {
            "it": "ZIP con i singoli CSV",
            "en": "ZIP of individual CSV files"
          },
          "detail": {
            "it": "Un elenco per ogni valore",
            "en": "One list for each value"
          }
        }
      ]
    }
  ]
}
